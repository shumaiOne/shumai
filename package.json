{
  "name": "shumai",
  "version": "0.4.2",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shumaiOne/shumai.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --hot apps/web/src/index.ts",
    "i18n:compile": "paraglide-js compile --project ./packages/webui/project.inlang --outdir ./packages/webui/paraglide --emit-ts-declarations --no-emit-git-ignore",
    "i18n:watch": "paraglide-js compile --project ./packages/webui/project.inlang --outdir ./packages/webui/paraglide --watch --emit-ts-declarations --no-emit-git-ignore",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "bun --bun vitest run",
    "test:e2e:app": "playwright test --project=app-chromium",
    "test:e2e:webui": "E2E_SKIP_APP_SERVER=true playwright test --project=harness-chromium",
    "test:e2e:all": "playwright test",
    "test:e2e:workflow": "bun --bun vitest run -c packages/e2e/vitest.config.ts",
    "test:e2e:install": "playwright install --with-deps",
    "harness:dev": "bun run packages/webui/e2e/harness/serve.ts",
    "format": "prettier --write .",
    "db:migrate": "bun run prisma migrate dev",
    "db:deploy": "bun run prisma migrate deploy",
    "db:generate": "cd packages/db && bunx prisma generate",
    "worker:agent": "bun apps/agent/src/index.ts",
    "worker:transcode": "bun apps/transcode/src/index.ts",
    "build": "bun run build.ts",
    "build-npm": "bun scripts/build-npm.ts",
    "prepublishOnly": "bun run build-npm && bun run lint && bun run typecheck",
    "publish": "bun run prepublishOnly && bun run scripts/publish.ts",
    "publish:dry": "bun run prepublishOnly && bun run scripts/publish.ts --dry-run",
    "release:local": "bun run scripts/release-local.ts",
    "release:patch": "bun run scripts/release.ts patch",
    "release:minor": "bun run scripts/release.ts minor",
    "release:major": "bun run scripts/release.ts major"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@inlang/paraglide-js": "2.25.0",
    "@playwright/test": "1.61.1",
    "@testcontainers/postgresql": "12.1.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.0",
    "@types/node": "25.9.1",
    "bun-plugin-pino": "1.5.0",
    "bun-plugin-tailwind": "0.1.2",
    "bun-types": "1.4.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "globals": "17.11.0",
    "happy-dom": "20.12.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  },
  "patchedDependencies": {
    "@earendil-works/pi-ai@0.82.1": "patches/@earendil-works%2Fpi-ai@0.82.1.patch"
  }
}
