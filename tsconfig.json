{
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "types": ["bun"],
    "paths": {
      "@/ui/*": ["packages/webui/*"],
      "@shumai/webui": ["packages/webui/index.html"],
      "@shumai/api": ["packages/api/src/index.ts"],
      "@shumai/core": ["packages/core/src/index.ts"],
      "@shumai/core/src/*": ["packages/core/src/*"],
      "@shumai/db": ["packages/db/src/index.ts"],
      "@shumai/dtos": ["packages/dtos/src/index.ts"],
      "@shumai/workflow-core": ["packages/workflow-core/src/index.ts"],
      "@shumai/agent": ["packages/agent/src/index.ts"],
      "@shumai/transcode": ["packages/transcode/src/index.ts"],
      "@shumai/worker-db": ["packages/worker-db/src/index.ts"]
    }
  },
  "exclude": ["node_modules"]
}
